<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="620.0" prefWidth="900.0" style="-fx-background-color: #6a3fb5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="banco.controller.LoginController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="380.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 18;">
         <padding>
            <Insets bottom="36.0" left="36.0" right="36.0" top="50.0" />
         </padding>
         <effect>
            <DropShadow blurType="GAUSSIAN" color="#00000066" offsetY="10.0" radius="30.0" />
         </effect>
         <children>

            <StackPane>
               <children>
                  <Label text="Faça seu login" textFill="#1b2a33">
                     <style>-fx-font-size: 22px; -fx-font-weight: bold;</style>
                     <StackPane.margin>
                        <Insets />
                     </StackPane.margin>
                     <padding>
                        <Insets bottom="30.0" />
                     </padding>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </StackPane>

            <VBox spacing="5.0">
               <children>
                  <Label text="CPF" textFill="#42535d">
                     <style>-fx-font-size: 12px; -fx-font-weight: bold;</style>
                  </Label>
                  <TextField fx:id="txtCpf" promptText="000.000.000-00" style="-fx-background-color: #f1f5f7; -fx-background-radius: 10; -fx-padding: 11 14 11 14; -fx-font-size: 14px;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Senha" textFill="#42535d">
                     <style>-fx-font-size: 12px; -fx-font-weight: bold;</style>
                  </Label>
                  <PasswordField fx:id="txtSenha" onAction="#onEntrar" promptText="Sua senha" style="-fx-background-color: #f1f5f7; -fx-background-radius: 10; -fx-padding: 11 14 11 14; -fx-font-size: 14px;" />
               </children>
            </VBox>

            <Label fx:id="lblErro" alignment="CENTER" maxWidth="1.7976931348623157E308" text="CPF ou senha inválidos" textAlignment="CENTER" visible="false" wrapText="true" style="-fx-background-color: #fdecec; -fx-background-radius: 10; -fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 12 8 12;" />

            <Button fx:id="btnEntrar" defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onEntrar" style="-fx-background-color: linear-gradient(to right, #2c5364, #203a43); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 0 12 0; -fx-cursor: hand;" text="Entrar">
               <padding>
                  <Insets bottom="10.0" />
               </padding></Button>

            <HBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label text="Ainda não tem conta?" textFill="#7a8a94">
                     <style>-fx-font-size: 12px;</style>
                  </Label>
                  <Hyperlink fx:id="linkCadastro" onAction="#onCadastro" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c5364;" text="Criar conta" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
