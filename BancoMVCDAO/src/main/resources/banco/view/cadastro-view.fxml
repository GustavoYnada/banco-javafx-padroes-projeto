<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="620.0" prefWidth="900.0" style="-fx-background-color: #6a3fb5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="banco.controller.CadastroController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="420.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 18;">
         <padding>
            <Insets bottom="28.0" left="36.0" right="36.0" top="32.0" />
         </padding>
         <effect>
            <DropShadow blurType="GAUSSIAN" color="#00000066" offsetY="10.0" radius="30.0" />
         </effect>
         <children>

            <Label text="Crie sua conta" textFill="#1b2a33">
               <style>-fx-font-size: 22px; -fx-font-weight: bold;</style>
               <VBox.margin>
                  <Insets bottom="8.0" />
               </VBox.margin>
            </Label>

            <VBox spacing="5.0">
               <children>
                  <Label text="Nome completo" textFill="#42535d">
                     <style>-fx-font-size: 12px; -fx-font-weight: bold;</style>
                  </Label>
                  <TextField fx:id="txtNome" promptText="Seu nome" style="-fx-background-color: #f1f5f7; -fx-background-radius: 10; -fx-padding: 11 14 11 14; -fx-font-size: 14px;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="CPF" textFill="#42535d">
                     <style>-fx-font-size: 12px; -fx-font-weight: bold;</style>
                  </Label>
                  <TextField fx:id="txtCpf" promptText="000.000.000-00" style="-fx-background-color: #f1f5f7; -fx-background-radius: 10; -fx-padding: 11 14 11 14; -fx-font-size: 14px;" />
               </children>
            </VBox>

            <HBox spacing="12.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Senha" textFill="#42535d">
                           <style>-fx-font-size: 12px; -fx-font-weight: bold;</style>
                        </Label>
                        <PasswordField fx:id="txtSenha" promptText="4 a 26 caracteres" style="-fx-background-color: #f1f5f7; -fx-background-radius: 10; -fx-padding: 11 14 11 14; -fx-font-size: 14px;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Confirmar senha" textFill="#42535d">
                           <style>-fx-font-size: 12px; -fx-font-weight: bold;</style>
                        </Label>
                        <PasswordField fx:id="txtConfirmaSenha" onAction="#onCadastrar" promptText="Repita a senha" style="-fx-background-color: #f1f5f7; -fx-background-radius: 10; -fx-padding: 11 14 11 14; -fx-font-size: 14px;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <ToggleButton fx:id="tglVip" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="false" style="-fx-background-color: #f1f5f7; -fx-background-insets: 0; -fx-background-radius: 10; -fx-border-color: transparent; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 11 14 11 14; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #42535d; -fx-cursor: hand; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" text="Conta VIP" />

            <Label fx:id="lblMsg" alignment="CENTER" maxWidth="1.7976931348623157E308" text="Mensagem" textAlignment="CENTER" visible="false" wrapText="true" style="-fx-background-color: #fdecec; -fx-background-radius: 10; -fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 12 8 12;" />

            <Button fx:id="btnCadastrar" defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCadastrar" style="-fx-background-color: linear-gradient(to right, #2c5364, #203a43); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 0 12 0; -fx-cursor: hand;" text="Cadastrar" />

            <HBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label text="Já tem conta?" textFill="#7a8a94">
                     <style>-fx-font-size: 12px;</style>
                  </Label>
                  <Hyperlink fx:id="linkVoltar" onAction="#onVoltar" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c5364;" text="Voltar ao login" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
