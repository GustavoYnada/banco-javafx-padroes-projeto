<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="620.0" prefWidth="900.0" style="-fx-background-color: #6a3fb5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="banco.controller.PainelVipController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="460.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 22;">
         <padding>
            <Insets bottom="22.0" left="34.0" right="34.0" top="22.0" />
         </padding>
         <effect>
            <DropShadow blurType="GAUSSIAN" color="#00000066" offsetY="10.0" radius="30.0" />
         </effect>
         <children>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Olá," textFill="#1b2a33" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                  <Label fx:id="lblNome" text="Nome" textFill="#1b2a33" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                  <Label text="VIP" style="-fx-background-color: #6a3fb5; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 9 3 9;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Hyperlink fx:id="linkSair" onAction="#onSair" text="Sair" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6a3fb5;" />
               </children>
            </HBox>

            <VBox spacing="2.0" style="-fx-background-color: #f5f0fc; -fx-background-radius: 20;">
               <padding>
                  <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
               </padding>
               <children>
                  <Label text="Saldo disponível" textFill="#7a8a94" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                  <Label fx:id="lblSaldo" text="R$ 0,00" textFill="#1b2a33" style="-fx-font-size: 32px; -fx-font-weight: bold;" />
               </children>
            </VBox>

            <VBox spacing="4.0" style="-fx-background-color: #fdf3f2; -fx-background-radius: 20;">
               <padding>
                  <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
               </padding>
               <children>
                  <Label text="Fatura de crédito" textFill="#7a8a94" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                  <Label fx:id="lblFatura" text="R$ 0,00" textFill="#c0392b" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                  <Label fx:id="lblLimite" text="Limite: R$ 0,00" textFill="#7a8a94" style="-fx-font-size: 11px;" />
               </children>
            </VBox>

            <HBox spacing="14.0">
               <children>
                  <Button fx:id="btnRetirar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onRetirar" text="Retirar" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to right, #6a3fb5, #8e44ad); -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14 0 14 0; -fx-cursor: hand;" />
                  <Button fx:id="btnTransferir" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onTransferir" text="Transferir" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to right, #6a3fb5, #8e44ad); -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14 0 14 0; -fx-cursor: hand;" />
               </children>
            </HBox>

            <Button fx:id="btnPagarFatura" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPagarFatura" text="Pagar fatura" style="-fx-background-color: #efe7fb; -fx-background-radius: 16; -fx-text-fill: #6a3fb5; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 0 12 0; -fx-cursor: hand;" />

            <Label fx:id="lblMsg" alignment="CENTER" maxWidth="1.7976931348623157E308" minHeight="48.0" prefHeight="48.0" maxHeight="48.0" text="Mensagem" textAlignment="CENTER" visible="false" wrapText="true" style="-fx-background-color: #fdecec; -fx-background-radius: 10; -fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 12 8 12;" />

            <HBox alignment="CENTER">
               <children>
                  <Hyperlink fx:id="linkExcluir" onAction="#onExcluirConta" text="Excluir minha conta" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #c0392b;" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
